EXIFTOOL_PATH=/opt/homebrew/bin/exiftool

# Production site URL (required for sitemap, OG tags, share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# Required for Pro Verify (SynthID + C2PA detection via OpenAI)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Optional: require customers to enter this code before running paid checks
# PRO_VERIFY_ACCESS_CODE=your-secret-pro-code

# Clerk authentication (optional — Pro Verify & Deep Clean protected when set)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhooks (required for billing lifecycle events at /api/webhooks/clerk)
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Clerk Pro Verify plan ID (Dashboard → Billing → Plans)
NEXT_PUBLIC_CLERK_PRO_VERIFY_PLAN_ID=cplan_3JFIl8kZnJfmIzworzOqwvBoxAy
